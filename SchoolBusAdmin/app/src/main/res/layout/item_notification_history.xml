<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Type and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Notification Type Badge -->
            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚌 Arrival Prediction"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_notification_arrival" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Time -->
            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textSize="10sp"
                android:textColor="@color/card_text_secondary" />

        </LinearLayout>

        <!-- Bus Info -->
        <TextView
            android:id="@+id/tv_bus_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus 101"
            android:textSize="13sp"
            android:textColor="@color/dashboard_accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Message -->
        <TextView
            android:id="@+id/tv_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus 101 will arrive at School Gate in 14 minutes"
            android:textSize="14sp"
            android:textColor="@color/card_text_primary"
            android:lineSpacingExtra="2dp" />

        <!-- Status Indicator (for read/unread) -->
        <View
            android:id="@+id/view_status_indicator"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="end"
            android:background="@color/secondary_color"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>